#!/usr/bin/env bash
#
# skills-deploy — copy canonical skills to agent harness target directories.
#
# Model:
#   ~/Me/repos/skills/  is the ONLY source of truth (this repo, git-tracked).
#     originals/<category>/<skill>/   your authored skills (tracked, pushed)
#     vendor/<skill>/                 third-party skills (gitignored, not pushed)
#     SOURCES.toml                    provenance for vendor/ (url + commit)
#     allowlist.txt                   target entries the deploy must NOT touch
#
#   Targets are generated; never hand-edit them:
#     ~/.agents/skills/   ZCode, Zed, Warp, Memo, opencode-CLI
#     ~/.codex/skills/    Codex (its .system/ built-ins are skipped)
#
# The repo directory tree IS the state. There is no lockfile or registry to rot.
# Re-running deploy with no changes is a no-op (rsync skips unchanged files).
#
# Craft Agents is intentionally out of scope: pull-based, workspace-scoped,
# UI-managed. Copy from originals/ or vendor/ via the Craft UI if needed.

set -euo pipefail

# ── Config ─────────────────────────────────────────────────────────────────

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Category skills live directly under the repo root (analysis/, planning/,
# vcs/, personal/, ...). vendor/ is the only special sibling.
ORIGINALS_DIR="$REPO_ROOT"
VENDOR_DIR="$REPO_ROOT/vendor"
ALLOWLIST="$REPO_ROOT/allowlist.txt"
SOURCES="$REPO_ROOT/SOURCES.toml"
GLOBAL_MANIFEST="$REPO_ROOT/global-manifest.toml"

# A project carries its scoping preferences in a manifest at this path
# (sibling to its skills/ dirs, never inside them).
PROJECT_MANIFEST_REL=".agents/skills-manifest.toml"

# Harness skills-subdir names that may exist at either scope (home or project).
HARNESS_SKILLS_DIRS=(".agents/skills" ".codex/skills")

# Top-level repo dirs that are NOT skill categories (skip when scanning).
NON_CATEGORY_DIRS=(deploy vendor .skillkit .git)

# Default deploy targets. Override by setting SKILLS_TARGETS (space-separated
# absolute paths) in the environment.
SKILLS_TARGETS_DEFAULT=(
    "$HOME/.agents/skills"
    "$HOME/.codex/skills"
)

# Where deleted target skills get backed up (recoverable — never rm -rf).
BACKUP_ROOT="${XDG_STATE_HOME:-$HOME/.local/state}/skills-backups"

# Files/dirs stripped on copy: bookkeeping and VCS cruft, not runtime-required.
STRIP_EXCLUDES=(
    --exclude='.DS_Store'
    --exclude='.skillkit.json'
    --exclude='.skillfish.json'
    --exclude='.git'
)

# ── Helpers ────────────────────────────────────────────────────────────────

color() { printf '\033[%sm%s\033[0m' "$1" "$2"; }
green()  { color '32' "$1"; }
yellow() { color '33' "$1"; }
red()    { color '31' "$1"; }
cyan()   { color '36' "$1"; }
dim()    { color '2'  "$1"; }

# Resolve the harness skills dirs at a given scope (home or project root).
# Emits absolute paths for every <root>/<harness>/skills that exists.
# `root="$HOME"` → global; `root=/path/to/project` → that project's dirs.
scope_targets() {
    local root="$1" sub
    for sub in "${HARNESS_SKILLS_DIRS[@]}"; do
        echo "$root/$sub"
    done
}

# Default global targets (home dirs). Overridable via SKILLS_TARGETS env.
global_targets() {
    if [[ -n "${SKILLS_TARGETS:-}" ]]; then
        printf '%s\n' $SKILLS_TARGETS
    else
        scope_targets "$HOME"
    fi
}

# Resolve target directories for a scope. Global targets honour the optional
# SKILLS_TARGETS override; project scopes always use the project's two harness
# directories.
scope_target_dirs() {
    local mode="$1" root="$2"
    if [[ "$mode" == "global" ]]; then
        global_targets
    else
        scope_targets "$root"
    fi
}

# Read the global manifest: list of canonical skill names that ship by default.
# Falls back to ALL canonical skills if the manifest is missing or has no
# `skills = [...]` list (so behaviour is "everything global" until curated).
global_manifest_skills() {
    if [[ ! -f "$GLOBAL_MANIFEST" ]]; then
        canonical_skill_names | sort -u
        return
    fi
    # Parse a TOML array of strings on a single `skills = [ ... ]` line.
    # Handles multiline arrays by collapsing newlines first.
    python3 -c "
import re, sys
txt = open('$GLOBAL_MANIFEST').read()
m = re.search(r'(?s)^skills\s*=\s*\[(.*?)\]', txt, re.M)
if not m:
    sys.exit(0)  # no list → empty (fall through to caller)
body = m.group(1)
for q in re.findall(r'\"([^\"]+)\"', body):
    print(q)
" | sort -u
}

# Read a project manifest's add/exclude lists. Echoes two lines:
#   line 1: space-separated add names
#   line 2: space-separated exclude names
# Empty manifest → empty add/exclude (project gets the bare global default).
project_manifest() {
    local manifest="$1"
    [[ -f "$manifest" ]] || { echo ""; echo ""; return; }
    python3 -c "
import re, sys
txt = open('$manifest').read()
def names(field):
    m = re.search(r'(?s)^' + field + r'\s*=\s*\[(.*?)\]', txt, re.M)
    return re.findall(r'\"([^\"]+)\"', m.group(1)) if m else []
print(' '.join(names('add')))
print(' '.join(names('exclude')))
"
}

# Resolve the skill set for a scope. Echoes one skill name per line.
#   global mode:   global_manifest_skills
#   project mode:  (global_manifest_skills - exclude) + add
# Drops names that don't exist in canonical (typo guard).
resolve_skill_set() {
    local mode="$1" project_manifest_file="${2:-}"
    local global add exclude
    global="$(global_manifest_skills)"
    if [[ "$mode" != "project" ]]; then
        echo "$global"
        return
    fi
    { read -r add; read -r exclude; } < <(project_manifest "$project_manifest_file")
    python3 -c "
import sys
g = set('''$global'''.split())
exclude = set('''$exclude'''.split())
add = set('''$add'''.split())
# (global - exclude) + add, filtered to canonical existence.
canonical = set('''$(canonical_skill_names)'''.split())
resolved = ((g - exclude) | add) & canonical
for n in sorted(resolved):
    print(n)
"
}

# Read allowlist into a newline-separated string (strip comments/blanks).
allowlist_patterns() {
    [[ -f "$ALLOWLIST" ]] || return 0
    grep -vE '^\s*(#|$)' "$ALLOWLIST" 2>/dev/null || true
}

# Test whether a top-level repo dir is a skill category (not infra).
is_category_dir() {
    local name; name="$(basename "$1")"
    local skip
    for skip in "${NON_CATEGORY_DIRS[@]}"; do
        [[ "$name" == "$skip" ]] && return 1
    done
    # Also skip dotfiles and anything not starting with a letter.
    [[ "$name" == .* ]] && return 1
    [[ "$name" == [a-z]* ]] || return 1
    return 0
}

# Test whether a name matches any allowlist pattern (exact or glob).
is_allowlisted() {
    local name="$1" pattern
    while IFS= read -r pattern; do
        [[ -z "$pattern" ]] && continue
        # shellcheck disable=SC2053
        [[ "$name" == $pattern ]] && return 0
    done < <(allowlist_patterns)
    return 1
}

# List canonical skill names (flattened): one per line, just the skill dir name.
# originals/ has <category>/<skill>/; vendor/ has <skill>/ directly.
canonical_skill_names() {
    local category skill
    if [[ -d "$ORIGINALS_DIR" ]]; then
        for category in "$ORIGINALS_DIR"/*/; do
            [[ -d "$category" ]] || continue
            is_category_dir "$category" || continue
            for skill in "$category"*/; do
                [[ -d "$skill" ]] || continue
                [[ -f "$skill/SKILL.md" ]] || continue
                basename "$skill"
            done
        done
    fi
    if [[ -d "$VENDOR_DIR" ]]; then
        for skill in "$VENDOR_DIR"/*/; do
            [[ -d "$skill" ]] || continue
            [[ -f "$skill/SKILL.md" ]] || continue
            basename "$skill"
        done
    fi
}

# Resolve the source dir for a canonical skill name (searches originals then vendor).
canonical_source_for() {
    local name="$1" category skill
    if [[ -d "$ORIGINALS_DIR" ]]; then
        for category in "$ORIGINALS_DIR"/*/; do
            [[ -d "$category" ]] || continue
            is_category_dir "$category" || continue
            skill="${category%/}/$name"
            if [[ -f "$skill/SKILL.md" ]]; then
                echo "$skill"; return 0
            fi
        done
    fi
    if [[ -d "$VENDOR_DIR" ]]; then
        skill="$VENDOR_DIR/$name"
        if [[ -f "$skill/SKILL.md" ]]; then
            echo "$skill"; return 0
        fi
    fi
    return 1
}

# List real directory entries in a target, skipping symlinks (plugin-managed)
# and the special .system dir (Codex built-ins).
target_real_skill_names() {
    local target="$1" entry name
    [[ -d "$target" ]] || return 0
    for entry in "$target"/*/; do
        [[ -e "$entry" ]] || continue
        [[ -L "${entry%/}" ]] && continue          # skip symlinks (plugins)
        name="$(basename "${entry%/}")"
        [[ "$name" == ".system" ]] && continue      # skip Codex built-ins
        echo "$name"
    done
}

new_backup_dir() {
    local stamp; stamp="$(date +%Y%m%d-%H%M%S)"
    echo "$BACKUP_ROOT/$stamp"
}

# ── Subcommand: deploy ─────────────────────────────────────────────────────

cmd_deploy() {
    local dry_run=0 strict=0 dest=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run) dry_run=1; shift ;;
            --strict)  strict=1; shift ;;
            --dest)    dest="$2"; shift 2 ;;
            --dest=*)  dest="${1#*=}"; shift ;;
            *) echo "$(red 'error'): unknown option $1" >&2; return 2 ;;
        esac
    done

    # Resolve scope: global (default) or project (--dest).
    local mode="global" scope_root="$HOME" manifest_file=""
    if [[ -n "$dest" ]]; then
        # Normalise to absolute path.
        [[ "$dest" != /* ]] && dest="$PWD/$dest"
        if [[ ! -d "$dest" ]]; then
            echo "$(red 'error'): --dest project does not exist: $dest" >&2; return 1
        fi
        mode="project"
        scope_root="$dest"
        manifest_file="$dest/$PROJECT_MANIFEST_REL"
    fi

    # Resolve the skill set for this scope.
    local resolved
    resolved="$(resolve_skill_set "$mode" "$manifest_file")"
    if [[ -z "$resolved" ]]; then
        echo "$(red 'error'): resolved skill set is empty for $mode scope" >&2; return 1
    fi
    local resolved_count; resolved_count=$(echo "$resolved" | wc -l | tr -d ' ')

    echo "$(cyan 'deploy') [$mode]: $resolved_count skill(s)"

    # Global scope only: warn if canonical has skills absent from global-manifest.
    # These won't deploy globally (manifest is authoritative) — may be deliberate
    # (project-add-only) or an oversight (footgun). --strict promotes to error.
    if [[ "$mode" == "global" ]]; then
        local manifest_missing
        manifest_missing="$(comm -23 \
            <(canonical_skill_names | sort -u) \
            <(global_manifest_skills) 2>/dev/null)"
        if [[ -n "$manifest_missing" ]]; then
            local missing_count; missing_count=$(echo "$manifest_missing" | grep -c .)
            if [[ $strict -eq 1 ]]; then
                echo "$(red 'error'): $missing_count canonical skill(s) absent from global-manifest.toml (--strict)" >&2
                echo "$manifest_missing" | sed 's/^/    /' >&2
                echo "  Add them to global-manifest.toml, or deploy --dest <project> if they're project-only." >&2
                return 1
            else
                echo "$(yellow 'warn'): $missing_count canonical skill(s) absent from global-manifest.toml (won't deploy globally; may be intentional):"
                echo "$manifest_missing" | sed "s/^/    /" | sed "s/^/$(printf '\033[2m')/;s/$/$(printf '\033[0m')/" >&2
            fi
        fi
    fi

    if [[ "$mode" == "project" ]]; then
        echo "  $(dim "project: $scope_root")"
        if [[ -f "$manifest_file" ]]; then
            echo "  $(dim "manifest: $manifest_file")"
        else
            echo "  $(dim "no project manifest — bare global default applies")"
        fi
    fi
    [[ $dry_run -eq 1 ]] && echo "$(dim '(dry-run — no changes written)')"
    echo

    local target name src dest_path
    local adds=0 updates=0 unchanged=0 removes=0 skipped_allow=0 skipped_link=0

    while IFS= read -r target; do
        [[ -n "$target" ]] || continue
        echo "$(cyan 'target'): $target"

        # ── Copy/update each resolved skill into this target ──
        while IFS= read -r name; do
            [[ -n "$name" ]] || continue
            src="$(canonical_source_for "$name")"
            [[ -z "$src" ]] && { echo "  $(red 'warn     ') $name not in canonical — skipping" >&2; continue; }
            dest_path="$target/$name"

            if [[ -L "$dest_path" ]]; then
                # Symlink in target — leave it (plugin-managed or hand-wired).
                echo "  $(yellow 'skip-link ') $name"
                skipped_link=$((skipped_link+1))
                continue
            fi

            if [[ ! -e "$dest_path" ]]; then
                if [[ $dry_run -eq 1 ]]; then
                    echo "  $(green 'add     ') $name"
                else
                    mkdir -p "$target"
                    rsync -aL "${STRIP_EXCLUDES[@]}" "$src/" "$dest_path/"
                    echo "  $(green 'added   ') $name"
                fi
                adds=$((adds+1))
            else
                # Detect whether rsync would change anything via --itemize-changes.
                local diff
                diff="$(rsync -aL --delete --dry-run --itemize-changes --out-format='%n' \
                            "${STRIP_EXCLUDES[@]}" "$src/" "$dest_path/" || true)"
                if [[ -z "$diff" ]]; then
                    echo "  $(dim 'unchanged') $name"; unchanged=$((unchanged+1))
                else
                    if [[ $dry_run -eq 1 ]]; then
                        echo "  $(yellow 'update   ') $name"
                    else
                        rsync -aL --delete "${STRIP_EXCLUDES[@]}" "$src/" "$dest_path/"
                        echo "  $(yellow 'updated ') $name"
                    fi
                    updates=$((updates+1))
                fi
            fi
        done <<< "$resolved"

        # ── Mirror cleanup: remove target skills not in resolved set ──
        [[ -d "$target" ]] && while IFS= read -r name; do
            [[ -n "$name" ]] || continue
            if grep -qxF "$name" <<< "$resolved"; then
                continue   # managed skill
            fi
            if is_allowlisted "$name"; then
                echo "  $(dim 'skip-alw  ') $name"
                skipped_allow=$((skipped_allow+1))
                continue
            fi
            if [[ $dry_run -eq 1 ]]; then
                echo "  $(red 'remove   ') $name  $(dim '(would back up + delete)')"
            else
                local backup; backup="$(new_backup_dir)"
                mkdir -p "$backup"
                mv "$target/$name" "$backup/"
                echo "  $(red 'removed ') $name  $(dim "(backed up -> $backup/$name)")"
            fi
            removes=$((removes+1))
        done < <(target_real_skill_names "$target")

        echo
    done < <(scope_target_dirs "$mode" "$scope_root")

    echo "$(cyan 'summary'): ${adds} added, ${updates} updated, ${unchanged} unchanged, ${removes} removed, ${skipped_allow} allowlisted, ${skipped_link} symlink-skipped"
}

# ── Subcommand: gather ─────────────────────────────────────────────────────
# Pulls a stray skill from a target into the canonical store (destination → source).
# The opposite of bootstrap drift: adopt a skill so deploy can manage it.

cmd_gather() {
    local name="" from="" category="personal"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --from) from="$2"; shift 2 ;;
            --category) category="$2"; shift 2 ;;
            -*) echo "$(red 'error'): unknown option $1" >&2; return 2 ;;
            *) name="$1"; shift ;;
        esac
    done

    if [[ -z "$name" ]]; then
        echo "Usage: skills-deploy gather <name> [--from codex|agents] [--category <cat>]" >&2
        echo "  Reads a skill from a harness target and adopts it into originals/<category>/<name>/" >&2
        return 2
    fi

    # Resolve the source target dir.
    local src=""
    case "$from" in
        codex)  src="$HOME/.codex/skills/$name" ;;
        agents) src="$HOME/.agents/skills/$name" ;;
        "") # Auto-detect: prefer .agents then .codex
            if   [[ -f "$HOME/.agents/skills/$name/SKILL.md" ]]; then src="$HOME/.agents/skills/$name"
            elif [[ -f "$HOME/.codex/skills/$name/SKILL.md" ]]; then src="$HOME/.codex/skills/$name"; fi
            ;;
        *) echo "$(red 'error'): --from must be 'codex' or 'agents'" >&2; return 2 ;;
    esac

    if [[ -z "$src" || ! -f "$src/SKILL.md" ]]; then
        echo "$(red 'error'): skill '$name' not found in any target" >&2
        return 1
    fi

    local dest="$ORIGINALS_DIR/$category/$name"
    if [[ -e "$dest" ]]; then
        echo "$(red 'error'): canonical destination already exists: $dest" >&2
        echo "  (move or remove it first, or use a different --category)" >&2
        return 1
    fi

    mkdir -p "$(dirname "$dest")"
    rsync -aL "${STRIP_EXCLUDES[@]}" "$src/" "$dest/"
    echo "$(green 'gathered'): $name"
    echo "  from: $src"
    echo "  to:   $dest"
    echo "  $(dim 'review, then commit. Run deploy to make the target a clean mirror.')"
}

# ── Subcommand: reconcile ──────────────────────────────────────────────────
# Detect orphan drift (skills in targets but not in canonical) and gather all
# strays in one pass. The bulk-drift cure; complement to single-skill `gather`.
#
# Handles ORPHAN drift only (skill exists in target, not in canonical). It does
# NOT detect CONTENT drift (canonical skill edited differently in a target) —
# that needs deliberate review.

cmd_reconcile() {
    local dry_run=0 dest="" category="personal"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run)  dry_run=1; shift ;;
            --dest)     dest="$2"; shift 2 ;;
            --dest=*)   dest="${1#*=}"; shift ;;
            --category) category="$2"; shift 2 ;;
            *) echo "$(red 'error'): unknown option $1" >&2; return 2 ;;
        esac
    done

    # Resolve scope (mirror cmd_deploy's logic).
    local mode="global" scope_root="$HOME" manifest_file=""
    if [[ -n "$dest" ]]; then
        [[ "$dest" != /* ]] && dest="$PWD/$dest"
        [[ -d "$dest" ]] || { echo "$(red 'error'): --dest project does not exist: $dest" >&2; return 1; }
        mode="project"; scope_root="$dest"
        manifest_file="$dest/$PROJECT_MANIFEST_REL"
    fi

    local resolved
    resolved="$(resolve_skill_set "$mode" "$manifest_file")"

    # Collect strays: target skills not in resolved set, not allowlisted, not symlinks.
    local -a strays=()
    local target name
    while IFS= read -r target; do
        [[ -d "$target" ]] || continue
        while IFS= read -r name; do
            [[ -n "$name" ]] || continue
            grep -qxF "$name" <<< "$resolved" && continue      # managed skill
            is_allowlisted "$name" && continue                  # allowlisted (.system, plugins)
            [[ -L "$target/$name" ]] && continue                # symlink (plugin-managed)
            strays+=("$name|$target")
        done < <(target_real_skill_names "$target")
    done < <(scope_target_dirs "$mode" "$scope_root")

    if [[ ${#strays[@]} -eq 0 ]]; then
        echo "$(green 'no drift'): no orphan skills detected in $mode scope"
        return 0
    fi

    echo "$(cyan 'reconcile') [$mode]: ${#strays[@]} orphan skill(s) to gather"
    [[ $dry_run -eq 1 ]] && echo "$(dim '(dry-run — no changes written)')"
    echo

    # De-duplicate strays by skill name (a stray may appear in both targets;
    # gather once from the first target that has it).
    # bash 3.2 (macOS) has no associative arrays — use a newline-separated string.
    local seen="" entry sname target gathered=0
    for entry in "${strays[@]}"; do
        sname="${entry%%|*}"
        grep -qxF "$sname" <<< "$seen" && continue
        seen+="$sname"$'\n'

        if [[ $dry_run -eq 1 ]]; then
            echo "  $(yellow 'would gather') $sname  $(dim "→ $category/$sname")"
        else
            # Find the first target that actually has this skill.
            target=""
            while IFS= read -r t; do
                [[ -f "$t/$sname/SKILL.md" ]] && target="$t/$sname" && break
            done < <(scope_target_dirs "$mode" "$scope_root")
            if [[ -z "$target" ]]; then
                echo "  $(red 'error    ') $sname — SKILL.md not found in any target" >&2
                continue
            fi
            local canon_dest="$ORIGINALS_DIR/$category/$sname"
            if [[ -e "$canon_dest" ]]; then
                echo "  $(yellow 'skip     ') $sname — already canonical (content drift; review manually)" >&2
                continue
            fi
            mkdir -p "$(dirname "$canon_dest")"
            rsync -aL "${STRIP_EXCLUDES[@]}" "$target/" "$canon_dest/"
            echo "  $(green 'gathered ') $sname  $(dim "← $target → $category/$sname")"
            gathered=$((gathered+1))
        fi
    done

    if [[ $dry_run -eq 0 && $gathered -gt 0 ]]; then
        echo
        echo "$(dim 'gathered skills are in canonical but not yet deployed. Run:')"
        if [[ -n "$dest" ]]; then
            echo "$(dim "  ./deploy/skills-deploy deploy --dest \"$dest\"")"
        else
            echo "$(dim '  ./deploy/skills-deploy deploy')"
        fi
    fi
}

# ── Subcommand: audit ─────────────────────────────────────────────────────
# Read-only comparison of the resolved canonical set with each target. Unlike
# reconcile, this checks content as well as names and never gathers or removes
# anything. A non-zero result means at least one target differs from the
# resolved set.

cmd_audit() {
    local dest="" mode="global" scope_root="$HOME" manifest_file=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dest)   dest="$2"; shift 2 ;;
            --dest=*) dest="${1#*=}"; shift ;;
            *) echo "$(red 'error'): unknown option $1" >&2; return 2 ;;
        esac
    done

    if [[ -n "$dest" ]]; then
        [[ "$dest" != /* ]] && dest="$PWD/$dest"
        [[ -d "$dest" ]] || { echo "$(red 'error'): --dest project does not exist: $dest" >&2; return 1; }
        mode="project"
        scope_root="$dest"
        manifest_file="$dest/$PROJECT_MANIFEST_REL"
    fi

    local resolved
    resolved="$(resolve_skill_set "$mode" "$manifest_file")"
    [[ -n "$resolved" ]] || { echo "$(red 'error'): resolved skill set is empty for $mode scope" >&2; return 1; }

    echo "$(cyan 'audit') [$mode]: content and name comparison"
    [[ "$mode" == "project" ]] && echo "  $(dim "project: $scope_root")"

    # Canonical skills outside the global manifest are not necessarily drift;
    # they may be deliberately project-scoped. Report them as an inventory
    # reminder rather than failing the target comparison.
    if [[ "$mode" == "global" ]]; then
        local unmanaged
        unmanaged="$(comm -23 \
            <(canonical_skill_names | sort -u) \
            <(global_manifest_skills) 2>/dev/null)"
        if [[ -n "$unmanaged" ]]; then
            echo "$(yellow 'unmanaged canonical skills') (not in global-manifest.toml):"
            echo "$unmanaged" | sed 's/^/  /'
        fi
    fi

    local drift=0 target name src dest_path diff
    while IFS= read -r target; do
        [[ -n "$target" ]] || continue
        echo
        echo "$(cyan 'target'): $target"
        if [[ ! -d "$target" ]]; then
            echo "  $(red 'missing-target') target directory does not exist"
            drift=1
            continue
        fi

        while IFS= read -r name; do
            [[ -n "$name" ]] || continue
            src="$(canonical_source_for "$name")"
            dest_path="$target/$name"
            if [[ -L "$dest_path" ]]; then
                echo "  $(dim 'skip-link ') $name"
                continue
            fi
            if [[ ! -e "$dest_path" ]]; then
                echo "  $(red 'missing   ') $name"
                drift=1
                continue
            fi
            # Audit content and names, not filesystem ownership or timestamps.
            # --checksum catches content drift that preserves size and mtime;
            # name-only output avoids treating timestamp metadata as content.
            diff="$(rsync -rL --checksum --delete --dry-run --out-format='%n' \
                        "${STRIP_EXCLUDES[@]}" "$src/" "$dest_path/" || true)"
            if [[ -n "$diff" ]]; then
                echo "  $(yellow 'changed   ') $name"
                echo "$diff" | sed 's/^/      /'
                drift=1
            else
                echo "  $(dim 'unchanged ') $name"
            fi
        done <<< "$resolved"

        while IFS= read -r name; do
            [[ -n "$name" ]] || continue
            grep -qxF "$name" <<< "$resolved" && continue
            is_allowlisted "$name" && continue
            echo "  $(red 'extra     ') $name"
            drift=1
        done < <(target_real_skill_names "$target")
    done < <(scope_target_dirs "$mode" "$scope_root")

    echo
    if [[ $drift -eq 0 ]]; then
        echo "$(green 'audit clean'): all resolved targets match canonical content"
        return 0
    fi
    echo "$(red 'audit differences found'): review before deploying"
    return 1
}

# ── Subcommand: lint ───────────────────────────────────────────────────────
# Read-only structural and editorial checks for canonical skills. Default mode
# reports warnings without blocking; --strict turns warnings into a failure so
# release checks can opt into a quality gate without making ordinary inventory
# work noisy or brittle.

cmd_lint() {
    local strict=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --strict) strict=1; shift ;;
            *) echo "$(red 'error'): unknown option $1" >&2; return 2 ;;
        esac
    done

    python3 - "$REPO_ROOT" "$GLOBAL_MANIFEST" "$strict" <<'PY'
from pathlib import Path
import re
import sys
import tomllib

root = Path(sys.argv[1])
manifest_path = Path(sys.argv[2])
strict = sys.argv[3] == "1"
skip = {".git", ".skillkit", "deploy", "vendor"}

sources = {}
for category in sorted(root.iterdir()):
    if not category.is_dir() or category.name.startswith(".") or category.name in skip:
        continue
    for skill in sorted(category.iterdir()):
        if skill.is_dir() and (skill / "SKILL.md").is_file():
            sources.setdefault(skill.name, (skill, "authored"))
vendor = root / "vendor"
if vendor.is_dir():
    for skill in sorted(vendor.iterdir()):
        if skill.is_dir() and (skill / "SKILL.md").is_file():
            if skill.name in sources:
                print(f"ERROR duplicate canonical skill name: {skill.name}")
            else:
                sources[skill.name] = (skill, "vendor")

errors = []
warnings = []
metadata_errors = []
long_skills = []
missing_triggers = []
missing_refs = []
old_refs = []

for name, (skill, kind) in sorted(sources.items()):
    path = skill / "SKILL.md"
    text = path.read_text(errors="replace")
    rel = str(path.relative_to(root))
    lines = text.splitlines()
    if not text.startswith("---"):
        errors.append(f"{rel}: missing YAML frontmatter")
        front = ""
    else:
        parts = text.split("---", 2)
        front = parts[1] if len(parts) == 3 else ""
        if len(parts) != 3:
            errors.append(f"{rel}: unterminated YAML frontmatter")

    name_match = re.search(r"(?m)^name:\s*(.+?)\s*$", front)
    if not name_match:
        errors.append(f"{rel}: missing frontmatter name")
    else:
        declared = name_match.group(1).strip().strip(" \"'")
        if declared != name:
            metadata_errors.append((name, f"{rel}: frontmatter name {declared!r} does not match directory {name!r}"))

    description_match = re.search(r"(?m)^description:\s*(.*)$", front)
    if not description_match:
        errors.append(f"{rel}: missing frontmatter description")
    elif not description_match.group(1).strip():
        # A folded or literal YAML block may put its value on following lines.
        line_no = front[:description_match.start()].count("\n")
        following = front.splitlines()[line_no + 1:]
        if not any(line.startswith((" ", "\t")) and line.strip() for line in following):
            errors.append(f"{rel}: empty frontmatter description")

    if len(lines) > 200:
        long_skills.append((name, f"{rel} ({len(lines)} lines)"))
    if not re.search(r"(?m)^triggers:\s*", front):
        missing_triggers.append((name, rel))

    if "/Users/bear/Me/00-system/agents/skills" in text:
        old_refs.append(rel)

    markdown_refs = set(re.findall(r"\[[^]]+\]\(([^)]+)\)", text))
    raw_refs = set(re.findall(r"(?<![A-Za-z0-9_./-])((?:references|scripts|docs|assets|templates|prompts)/[A-Za-z0-9_./-]+)", text))
    for ref in sorted(markdown_refs | raw_refs):
        ref = ref.split("#", 1)[0].strip()
        if not ref or ref.startswith(("http://", "https://", "mailto:", "#", "<")):
            continue
        if any(token in ref for token in ("...", "<", ">", "[[", "x.md", "foo.md")):
            continue
        if ref.startswith("/") or ref.startswith("~") or ref.startswith("$"):
            continue
        # Only treat a raw prose token as a path when it has a path-like
        # shape. Markdown links are more explicit, but bare words such as
        # "url" and "docs/help" are common prose and not file references.
        if ref in raw_refs and ref not in markdown_refs:
            if not (Path(ref).suffix or ref.startswith("../") or ref.endswith("/")):
                continue
        if ref in markdown_refs and not (Path(ref).suffix or "/" in ref or ref.startswith(("./", "../"))):
            continue
        if ref.startswith("tools/") and not Path(ref).suffix:
            continue
        if ref not in markdown_refs and not Path(ref).suffix:
            continue
        candidates = [skill / ref]
        if ref.startswith(("docs/", "scripts/")):
            candidates.append(root / ref)
        if not any(candidate.exists() for candidate in candidates):
            missing_refs.append(f"{rel} -> {ref}")

try:
    manifest = tomllib.loads(manifest_path.read_text())
    global_names = manifest.get("skills", [])
except (OSError, tomllib.TOMLDecodeError) as exc:
    errors.append(f"global-manifest.toml: cannot parse ({exc})")
    global_names = []

if len(global_names) != len(set(global_names)):
    errors.append("global-manifest.toml: duplicate skill names")
for name in global_names:
    if name not in sources:
        errors.append(f"global-manifest.toml: {name} has no canonical SKILL.md")

# Surface direct references from globally selected skills to canonical skills
# that are not globally available. This is a review finding, not an automatic
# error: some references are intentionally on-demand or project-scoped.
global_set = set(global_names)
for name, item in metadata_errors:
    if name in global_set:
        errors.append(item)
    else:
        warnings.append(f"non-global metadata mismatch: {item}")
for name in global_names:
    if name not in sources:
        continue
    text = (sources[name][0] / "SKILL.md").read_text(errors="replace")
    refs = sorted({ref for ref in re.findall(r"`([a-z0-9][a-z0-9-]*)`", text)
                   if ref in sources and ref != name and ref not in global_set})
    if refs:
        warnings.append(f"global dependency outside manifest: {name} -> {', '.join(refs)}")

# Explicit triggers are encouraged for auto-loaded global skills, but are not
# mandatory for every project, vendor or command skill.
global_set = set(global_names)
warnings.extend(f"over 200 lines: {item}" for name, item in long_skills if name in global_set)
warnings.extend(f"no explicit triggers (global): {item}" for name, item in missing_triggers if name in global_set)
warnings.extend(f"missing relative reference: {item}" for item in missing_refs)
warnings.extend(f"obsolete absolute skill path: {item}" for item in old_refs)

print(f"lint: {len(sources)} canonical skills; {len(global_names)} global entries")
for item in errors:
    print(f"ERROR {item}")
for item in warnings:
    print(f"WARN  {item}")
print(f"summary: {len(errors)} error(s), {len(warnings)} warning(s)")
if errors or (strict and warnings):
    raise SystemExit(1)
PY
}

# ── Vendor provenance helpers ─────────────────────────────────────────────

# Read one vendor entry from SOURCES.toml. Emits url, commit and optional path
# on separate lines. This deliberately handles the small repository-owned TOML
# shape rather than pretending to be a general TOML parser.
source_entry() {
    local name="$1"
    python3 - "$SOURCES" "$name" <<'PY'
import re
import sys

path, name = sys.argv[1:]
text = open(path).read()
match = re.search(r"(?ms)^\[" + re.escape(name) + r"\]\s*\n(.*?)(?=^\[|\Z)", text)
if not match:
    raise SystemExit(1)
block = match.group(1)
for key in ("url", "commit", "path"):
    item = re.search(r"(?m)^" + key + r"\s*=\s*\"([^\"]*)\"\s*$", block)
    print(item.group(1) if item else "")
PY
}

# Update one existing vendor entry while preserving the surrounding file and
# section order. The optional path makes renamed or multi-skill upstreams
# reproducible at a pinned commit.
update_source_entry() {
    local name="$1" url="$2" commit="$3" skill_path="$4"
    python3 - "$SOURCES" "$name" "$url" "$commit" "$skill_path" <<'PY'
import re
import sys

path, name, url, commit, skill_path = sys.argv[1:]
text = open(path).read()
match = re.search(r"(?ms)^\[" + re.escape(name) + r"\]\s*\n(.*?)(?=^\[|\Z)", text)
if not match:
    raise SystemExit(f"missing SOURCES.toml entry: {name}")
block = match.group(1)

def set_field(body, key, value):
    line = f'{key} = "{value}"'
    pattern = re.compile(r"(?m)^" + re.escape(key) + r"\s*=\s*\"[^\"]*\"\s*$")
    if pattern.search(body):
        return pattern.sub(line, body, count=1)
    return body.rstrip("\n") + "\n" + line + "\n"

block = set_field(block, "url", url)
block = set_field(block, "commit", commit)
if skill_path:
    block = set_field(block, "path", skill_path)
else:
    block = re.sub(r"(?m)^path\s*=\s*\"[^\"]*\"\s*\n?", "", block)

text = text[:match.start(1)] + block + text[match.end(1):]
open(path, "w").write(text)
PY
}

# ── Subcommand: update ────────────────────────────────────────────────────
# Refresh an existing vendored skill from its recorded upstream. The default
# follows the upstream default branch; --ref is available for historical or
# renamed paths. --dry-run never changes vendor/ or SOURCES.toml.

cmd_update() {
    local name="" dry_run=0 ref=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run) dry_run=1; shift ;;
            --ref) ref="$2"; shift 2 ;;
            --ref=*) ref="${1#*=}"; shift ;;
            -*) echo "$(red 'error'): unknown option $1" >&2; return 2 ;;
            *)
                [[ -z "$name" ]] || { echo "$(red 'error'): update accepts one skill name" >&2; return 2; }
                name="$1"; shift ;;
        esac
    done

    if [[ -z "$name" ]]; then
        echo "Usage: skills-deploy update <name> [--dry-run] [--ref <commit>]" >&2
        return 2
    fi
    local dest="$VENDOR_DIR/$name"
    [[ -f "$dest/SKILL.md" ]] || { echo "$(red 'error'): vendored skill not found: $name" >&2; return 1; }

    local entry
    entry="$(source_entry "$name")" || {
        echo "$(red 'error'): no SOURCES.toml entry for vendored skill '$name'" >&2
        return 1
    }
    local recorded_url recorded_commit recorded_path
    {
        IFS= read -r recorded_url || true
        IFS= read -r recorded_commit || true
        IFS= read -r recorded_path || true
    } <<< "$entry"
    if [[ -z "$recorded_url" || "$recorded_url" == UNKNOWN* || -z "$recorded_commit" || "$recorded_commit" == unverified ]]; then
        echo "$(red 'error'): provenance for '$name' is unresolved; record a verified URL and commit first" >&2
        return 1
    fi

    local tmp; tmp="$(mktemp -d)"
    # shellcheck disable=SC2064
    trap "rm -rf '$tmp'" EXIT

    echo "$(dim "cloning $recorded_url …")"
    git clone --quiet "$recorded_url" "$tmp/repo" >&2
    if [[ -n "$ref" ]]; then
        git -C "$tmp/repo" checkout --quiet --detach "$ref" || {
            echo "$(red 'error'): ref '$ref' is not available in $recorded_url" >&2
            return 1
        }
    fi

    local commit; commit="$(git -C "$tmp/repo" rev-parse HEAD)"
    local chosen=""
    if [[ -n "$recorded_path" ]]; then
        chosen="$tmp/repo/$recorded_path"
        [[ -f "$chosen/SKILL.md" ]] || {
            echo "$(red 'error'): recorded skill path '$recorded_path' is absent at $commit" >&2
            echo "  $(dim 'Use --ref <commit> to inspect the historical path, or review the upstream rename.')" >&2
            return 1
        }
    elif [[ -f "$tmp/repo/$name/SKILL.md" ]]; then
        chosen="$tmp/repo/$name"
    elif [[ -f "$tmp/repo/SKILL.md" ]]; then
        chosen="$tmp/repo"
    else
        local -a found=() m
        while IFS= read -r m; do found+=("$(dirname "$m")"); done \
            < <(find "$tmp/repo" -name SKILL.md -not -path '*/node_modules/*' 2>/dev/null)
        if [[ ${#found[@]} -eq 1 ]]; then
            chosen="${found[0]}"
        else
            echo "$(red 'error'): cannot identify '$name' in upstream at $commit" >&2
            printf '  %s\n' "${found[@]}" >&2
            return 1
        fi
    fi

    local skill_path=""
    [[ "$chosen" != "$tmp/repo" ]] && skill_path="${chosen#"$tmp/repo/"}"
    local diff
    # Name-only output deliberately ignores timestamp metadata while checksum
    # comparison still detects changed file content and structure.
    diff="$(rsync -rL --checksum --delete --dry-run --out-format='%n' \
        "${STRIP_EXCLUDES[@]}" "$chosen/" "$dest/" || true)"
    local source_changed=0
    [[ "$commit" != "$recorded_commit" || "$skill_path" != "$recorded_path" ]] && source_changed=1

    echo "$(cyan 'update') $name"
    echo "  source: $recorded_url"
    echo "  commit: $commit"
    [[ -n "$skill_path" ]] && echo "  path:   $skill_path"
    if [[ -n "$diff" ]]; then
        echo "  $(yellow 'content changes')"
        echo "$diff" | sed 's/^/    /'
    else
        echo "  $(dim 'content unchanged')"
    fi
    if [[ "$commit" != "$recorded_commit" ]]; then
        echo "  pin:    $recorded_commit → $commit"
    fi
    [[ "$skill_path" != "$recorded_path" ]] && echo "  path pin: ${recorded_path:-<none>} → ${skill_path:-<root>}"

    if [[ $dry_run -eq 1 ]]; then
        echo "  $(dim '(dry-run — no vendor or provenance changes written)')"
        return 0
    fi
    if [[ -n "$diff" ]]; then
        rsync -aL --delete "${STRIP_EXCLUDES[@]}" "$chosen/" "$dest/"
    fi
    if [[ $source_changed -eq 1 ]]; then
        update_source_entry "$name" "$recorded_url" "$commit" "$skill_path"
    fi
    if [[ -n "$diff" || $source_changed -eq 1 ]]; then
        echo "$(green 'updated'): $name"
    else
        echo "$(green 'up to date'): $name"
    fi
}

# ── Subcommand: fetch ──────────────────────────────────────────────────────
# Acquire a third-party skill via git, record provenance. No skillfish involved.

cmd_fetch() {
    local repo="" skill="" do_list=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --skill) skill="$2"; shift 2 ;;
            --list|-l) do_list=1; shift ;;
            -*) echo "$(red 'error'): unknown option $1" >&2; return 2 ;;
            *) repo="$1"; shift ;;
        esac
    done

    if [[ -z "$repo" ]]; then
        echo "Usage: skills-deploy fetch <owner/repo> [--skill <name>] [--list]" >&2
        echo "  Clones a skill repo into vendor/ and records provenance in SOURCES.toml." >&2
        return 2
    fi

    # Normalize owner/repo → full URL.
    local url="$repo"
    [[ "$url" != *://* ]] && url="https://github.com/$url"

    local tmp; tmp="$(mktemp -d)"
    # shellcheck disable=SC2064
    trap "rm -rf '$tmp'" EXIT

    echo "$(dim "cloning $url …")"
    git clone --depth 1 "$url" "$tmp/repo" >&2

    local commit; commit="$(git -C "$tmp/repo" rev-parse HEAD)"
    local short;  short="$(git -C "$tmp/repo" rev-parse --short HEAD)"

    # Find candidate skills (dirs containing SKILL.md).
    local -a found=()
    while IFS= read -r m; do found+=("$(dirname "$m")"); done \
        < <(find "$tmp/repo" -name SKILL.md -not -path '*/node_modules/*' 2>/dev/null)

    if [[ ${#found[@]} -eq 0 ]]; then
        echo "$(red 'error'): no SKILL.md found in $url" >&2; return 1
    fi

    if [[ $do_list -eq 1 ]]; then
        echo "$(cyan 'skills in $repo'):"
        local f
        for f in "${found[@]}"; do echo "  $(basename "$f")  $(dim "$f")"; done
        return 0
    fi

    local chosen
    if [[ -n "$skill" ]]; then
        chosen=""
        local f
        for f in "${found[@]}"; do
            if [[ "$(basename "$f")" == "$skill" ]]; then chosen="$f"; break; fi
        done
        if [[ -z "$chosen" ]]; then
            echo "$(red 'error'): --skill '$skill' not found. Available:" >&2
            printf '  %s\n' "${found[@]}" >&2
            return 1
        fi
    elif [[ ${#found[@]} -eq 1 ]]; then
        chosen="${found[0]}"
    else
        echo "$(yellow 'multiple skills found'):" >&2
        local i=0 f
        for f in "${found[@]}"; do echo "  [$i] $(basename "$f")  $(dim "$f")" >&2; i=$((i+1)); done
        printf 'pick one: ' >&2
        local idx; read -r idx
        chosen="${found[$idx]}"
    fi

    local sname
    if [[ "$chosen" == "$tmp/repo" ]]; then
        # SKILL.md is at the repo root: name the skill after the repo itself,
        # not the clone dir ('repo'). Strips trailing .git and any skill suffix.
        sname="$(basename "$url")"
        sname="${sname%.git}"
        sname="${sname%-skill}"
        sname="${sname%-claude-skill}"
    else
        sname="$(basename "$chosen")"
    fi
    local skill_path=""
    [[ "$chosen" != "$tmp/repo" ]] && skill_path="${chosen#"$tmp/repo/"}"
    local skill_path=""
    [[ "$chosen" != "$tmp/repo" ]] && skill_path="${chosen#"$tmp/repo/"}"
    local dest="$VENDOR_DIR/$sname"
    if [[ -e "$dest" ]]; then
        echo "$(red 'error'): vendor destination already exists: $dest" >&2
        echo "  (remove it first, or it'll be overwritten on next fetch)" >&2
        return 1
    fi

    mkdir -p "$VENDOR_DIR"
    rsync -aL "${STRIP_EXCLUDES[@]}" "$chosen/" "$dest/"

    # Append provenance to SOURCES.toml.
    local entry
    entry="$(printf '[%s]\nurl = "%s"\ncommit = "%s"\n' "$sname" "$url" "$commit")"
    [[ -n "$skill_path" ]] && entry+="$(printf 'path = "%s"\n' "$skill_path")"
    if [[ -f "$SOURCES" ]] && grep -q "^\[$sname\]" "$SOURCES"; then
        echo "$(yellow 'note'): $sname already in SOURCES.toml — provenance not updated" >&2
    else
        {
            echo ""
            echo "$entry"
        } >> "$SOURCES"
    fi

    echo "$(green 'fetched'): $sname"
    echo "  url:    $url"
    echo "  commit: $short"
    echo "  to:     $dest"
    echo "  $(dim 'recorded in SOURCES.toml. Run deploy to fan out to targets.')"
}

# ── Subcommand: list ───────────────────────────────────────────────────────

cmd_list() {
    echo "$(cyan 'canonical skills'):"
    local name src category
    while IFS= read -r name; do
        [[ -n "$name" ]] || continue
        src="$(canonical_source_for "$name")"
        if [[ "$src" == "$VENDOR_DIR"/* ]]; then
            printf '  %-30s %s\n' "$name" "$(dim 'vendor')"
        else
            category="$(basename "$(dirname "$src")")"
            printf '  %-30s %s\n' "$name" "$(dim "$category")"
        fi
    done < <(canonical_skill_names | sort -u)
    echo
    echo "$(cyan 'targets'):"
    global_targets | sed 's/^/  /'
    echo
    echo "$(cyan 'allowlist'):"
    if [[ -f "$ALLOWLIST" ]]; then
        allowlist_patterns | sed 's/^/  /'
    else
        echo "  $(dim '(no allowlist.txt)')"
    fi
}

# ── Usage ──────────────────────────────────────────────────────────────────

usage() {
    cat <<'EOF'
skills-deploy — manage canonical skills → harness targets

Subcommands:
  deploy [--dry-run] [--strict] [--dest <project>]
                                     Mirror resolved skills to harness targets.
                                     Without --dest: global scope (reads
                                     global-manifest.toml) → ~/.agents/skills,
                                     ~/.codex/skills.
                                     With --dest <project>: project scope (reads
                                     <project>/.agents/skills-manifest.toml) →
                                     that project's harness dirs. Resolution is
                                     (global_default - exclude) + add.
                                     --strict: error if canonical skills are
                                     absent from global-manifest.toml (else warn).
  gather <name> [--from codex|agents] [--category <cat>]
                                     Adopt a stray skill from a target into originals/
  reconcile [--dry-run] [--dest <project>] [--category <cat>]
                                     Gather ALL orphan skills (in targets but not
                                     canonical) in one pass. The bulk-drift cure.
                                     Handles orphan drift only, not content drift.
  audit [--dest <project>]           Compare resolved target names and content
                                     with canonical skills. Read-only; exits
                                     non-zero when differences are found.
  lint [--strict]                    Check canonical skill structure, metadata,
                                     references and manifest closure. Read-only;
                                     --strict treats warnings as failures.
  update <name> [--dry-run] [--ref <commit>]
                                     Refresh a vendored skill from SOURCES.toml;
                                     --ref supports historical pinned paths.
  fetch <owner/repo> [--skill <name>] [--list]
                                     Acquire a third-party skill into vendor/ via git
  list                               Show canonical skills, targets, and allowlist

Canonical store: ~/Me/repos/skills/
  <category>/<skill>/                your authored skills (git-tracked)
  vendor/<skill>/                    third-party (gitignored)
  global-manifest.toml               default set shipped globally
  SOURCES.toml                       provenance for vendor/
  allowlist.txt                      target entries never removed

Project manifests:
  <project>/.agents/skills-manifest.toml   add = [...], exclude = [...]

Env:
  SKILLS_TARGETS                     override GLOBAL target dirs (space-separated)
EOF
}

# ── Dispatch ───────────────────────────────────────────────────────────────

main() {
    local sub="${1:-}"
    [[ -z "$sub" ]] && { usage; return 0; }
    shift
    case "$sub" in
        deploy)    cmd_deploy "$@" ;;
        gather)    cmd_gather "$@" ;;
        reconcile) cmd_reconcile "$@" ;;
        audit)     cmd_audit "$@" ;;
        lint)      cmd_lint "$@" ;;
        update)    cmd_update "$@" ;;
        fetch)     cmd_fetch "$@" ;;
        list)      cmd_list ;;
        -h|--help|help) usage ;;
        *) echo "$(red 'error'): unknown subcommand '$sub'" >&2; usage; return 2 ;;
    esac
}

main "$@"
