#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "skills/bootstrap"
Skills::Bootstrap.ensure_dependencies!(project_root: File.expand_path("..", __dir__), argv: ARGV)
require "skills"

repository_root = File.expand_path("../../..", __dir__)
exit Skills::CLI.run(ARGV, root: repository_root)
