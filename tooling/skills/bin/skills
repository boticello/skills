#!/usr/bin/env ruby
# frozen_string_literal: true

# Re-exec under the Gemfile's pinned Ruby when invoked with a different one
# (e.g. the shebang resolved to a drifted mise default). Loop-guarded by env.
pin = File.read(File.expand_path("../Gemfile", __dir__))[/^ruby "(.+)"$/, 1]
if pin && RUBY_VERSION != pin && ENV["SKILLS_REEXEC"] != "1"
  ENV["SKILLS_REEXEC"] = "1"
  begin
    exec("mise", "x", "ruby@#{pin}", "--", "ruby", File.expand_path(__FILE__), *ARGV)
  rescue Errno::ENOENT
    warn "skills: running under Ruby #{RUBY_VERSION}, pinned #{pin}, and mise is unavailable"
  end
end

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "skills/bootstrap"
Skills::Bootstrap.ensure_dependencies!(project_root: File.expand_path("..", __dir__), argv: ARGV)
require "skills"

repository_root = File.expand_path("../../..", __dir__)
exit Skills::CLI.run(ARGV, root: repository_root)
